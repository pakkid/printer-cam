# Copy to .env and edit -- Docker Compose picks it up automatically.
#   cp .env.example .env
#
# In Portainer, set these under the stack's "Environment variables" instead;
# there is no .env file in a Git-backed stack.
#
# Changing any of these needs only a redeploy. Nothing inside the image
# hardcodes them.

# LAN address of the K2 / K2 Plus.
PRINTER_IP=192.168.1.17

# Host port the viewer is published on.
HTTP_PORT=1984

# Set to your Docker host's LAN address for real-time WebRTC playback.
# Leave unset to use the MSE fallback (~0.6s behind live).
#WEBRTC_CANDIDATE=192.168.1.50:8555

# HTTP basic auth. Leave AUTH_USER blank to disable.
AUTH_USER=
AUTH_PASS=

# info | debug | trace
LOG_LEVEL=info

# --- print progress overlay -------------------------------------------------
# Moonraker's port on the printer. Only the front-door container talks to it.
MOONRAKER_PORT=7125

# This printer's Moonraker does not parse slicer metadata, so it reports no
# filament weight -- only the extruded length. Grams are derived from these.
# Defaults are 1.75 mm PLA; PETG is ~1.27, ABS ~1.04, TPU ~1.21.
FILAMENT_DIAMETER=1.75
FILAMENT_DENSITY=1.24
