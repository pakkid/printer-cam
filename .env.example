# Copy to .env (or paste these as environment variables in the Portainer
# stack editor) and adjust.

# LAN address of the K2 / K2 Plus.
PRINTER_IP=192.168.1.17

# Host port the viewer is published on.
HTTP_PORT=1984

# HTTP basic auth. Leave AUTH_USER blank to disable.
AUTH_USER=
AUTH_PASS=

# info | debug | trace
LOG_LEVEL=info

# Set this to your Docker host's LAN address to get real-time WebRTC playback
# instead of the ~1.5s MSE fallback. Leave unset for MSE only.
# WEBRTC_CANDIDATE=192.168.1.50:8555
